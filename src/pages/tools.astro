---
import BaseLayout from "@/layouts/BaseLayout.astro";

const tools = [
  {
    name: "ChatGPT",
    category: "مساعد كتابة",
    description: "لإنشاء المحتوى، التلخيص، والإجابة على الأسئلة."
  },
  {
    name: "Midjourney",
    category: "توليد صور",
    description: "لإنشاء صور فنية وتسويقية بالذكاء الاصطناعي."
  },
  {
    name: "Runway",
    category: "فيديو",
    description: "لتحرير وإنتاج فيديوهات مدعومة بالذكاء الاصطناعي."
  }
];
---

<BaseLayout title="أدوات الذكاء الاصطناعي">
  <h1>دليل أدوات الذكاء الاصطناعي</h1>
  <p><a href="/">العودة للرئيسية</a></p>
  {
    tools.map((tool) => (
      <article style="border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin: 1rem 0;">
        <h2>{tool.name}</h2>
        <p><strong>التصنيف:</strong> {tool.category}</p>
        <p>{tool.description}</p>
      </article>
    ))
  }
</BaseLayout>
