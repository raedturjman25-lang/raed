---
const tools = [
  {
    name: "ChatGPT",
    category: "مساعد كتابة",
    description: "لإنشاء المحتوى، التلخيص، والإجابة على الأسئلة."
  },
  {
    name: "Midjourney",
    category: "توليد صور",
    description: "لإنشاء صور فنية وتسويقية بالذكاء الاصطناعي."
  },
  {
    name: "Runway",
    category: "فيديو",
    description: "لتحرير وإنتاج فيديوهات مدعومة بالذكاء الاصطناعي."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>أدوات الذكاء الاصطناعي</title>
  </head>
  <body>
    <main style="max-width: 900px; margin: 2rem auto; font-family: sans-serif; line-height: 1.8; padding: 0 1rem;">
      <h1>دليل أدوات الذكاء الاصطناعي</h1>
      <p><a href="/">العودة للرئيسية</a></p>
      {
        tools.map((tool) => (
          <article style="border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin: 1rem 0;">
            <h2>{tool.name}</h2>
            <p><strong>التصنيف:</strong> {tool.category}</p>
            <p>{tool.description}</p>
          </article>
        ))
      }
    </main>
  </body>
</html>
