---
import config from "@/config/config.json";
import "@/styles/site.css";

const { title = "", description = "" } = Astro.props;
const basePath = import.meta.env.BASE_URL || "/";

const normalizePath = (path: string) => {
  if (!path || path === "/") return "/";
  const normalized = path.startsWith("/") ? path : `/${path}`;
  return normalized.replace(/\/+$/, "");
};

const stripBasePath = (path: string) => {
  const normalizedPath = normalizePath(path);
  const normalizedBase = normalizePath(basePath);

  if (normalizedBase === "/" || !normalizedPath.startsWith(normalizedBase)) {
    return normalizedPath;
  }

  const stripped = normalizedPath.slice(normalizedBase.length);
  return normalizePath(stripped || "/");
};

const withBase = (path: string) => {
  const normalized = path === "/" ? "" : path.replace(/^\//, "");
  return `${basePath}${normalized}`;
};

const currentPath = stripBasePath(Astro.url.pathname);

const navItems = [
  { href: "/", label: "الرئيسية" },
  { href: "/tools", label: "الأدوات" },
  { href: "/articles", label: "المقالات" },
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={withBase("/")}>{config.site.title}</a>
        <nav class="nav" aria-label="التنقل الرئيسي">
          {
            navItems.map((item) => (
              <a
                href={withBase(item.href)}
                class={currentPath === normalizePath(item.href) ? "active" : ""}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="shell page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>© {new Date().getFullYear()} {config.site.title}</span>
        <span>منصة عربية للأدوات والمحتوى العملي</span>
      </div>
    </footer>
  </body>
</html>
